# Polygon RPC — usa Alchemy/QuickNode gratuito y sube el rango a 500-1000
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_MAX_BLOCK_RANGE=5
PROCESS_CHUNK_SIZE=500000

# Intervalo del loop del contenedor (segundos)
UPDATE_INTERVAL_SECONDS=900

# Trading real con Phantom (ver trading/README.md)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
SIGNATURE_TYPE=2
AUTO_EXECUTE=false
CLOB_HOST=https://clob.polymarket.com

# Telegram — crea un bot con @BotFather y obtén el chat_id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sizing por trade (TRADE_SIZE_PCT > 0 tiene prioridad sobre TRADE_SIZE_USD)
TRADE_SIZE_USD=5.0
TRADE_SIZE_PCT=0.0

# Gestión de riesgo: 0 = deshabilitado; requiere loop de monitoreo externo
STOP_LOSS_PCT=0.0
TAKE_PROFIT_PCT=0.0
